{
  "name": "@talknest/frontend",
  "version": "1.0.0",
  "type": "module",
  "author": "Mohamed Kamel",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rimraf ./dist",
    "clean:deps": "rimraf node_modules",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:dev": "vite",
    "test:unit:dev": "jest -c jest.config.unit.ts --watch",
    "test:infra:dev": "jest -c jest.config.infra.ts --watch",
    "test:e2e:dev": "jest -c jest.config.e2e.ts --watch",
    "test:unit": "jest -c jest.config.unit.ts",
    "test:infra": "jest -c jest.config.infra.ts",
    "test:e2e": "jest -c jest.config.e2e.ts"
  },
  "dependencies": {
    "@talknest/api": "workspace:*",
    "@talknest/errors": "workspace:*",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-loader-spinner": "^8.0.2",
    "react-moment": "^1.1.3",
    "react-router-dom": "^6.20.0",
    "react-toastify": "^9.1.3"
  },
  "devDependencies": {
    "@talknest/test-support": "workspace:*",
    "@talknest/utils": "workspace:*",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "puppeteer": "^24.42.0",
    "vite": "^5.0.0"
  }
}