{
  "name": "@talknest/backend",
  "description": "A forum web application for developers to share ideas, thoughts, and experiences about Domain-Driven Design (DDD).",
  "version": "1.0.0",
  "author": "Mohamed Kamel",
  "license": "ISC",
  "private": true,
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "clean:deps": "rimraf node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "build": "tsc --build",
    "start": "node --import tsx dist/index.js",
    "start:dev": "nodemon",
    "prettier-format": "run-script-os",
    "prettier-format:win32": "prettier --config .prettierrc \"./src/**/*.ts\" --write",
    "prettier-format:darwin:linux": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "prettier-format:default": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "prettier-watch": "run-script-os",
    "prettier-watch:win32": "onchange \"src/**/*.ts\" -- prettier --write {{changed}}",
    "prettier-watch:darwin:linux": "onchange 'src/**/*.ts' -- prettier --write {{changed}}",
    "prettier-watch:default": "onchange 'src/**/*.ts' -- prettier --write {{changed}}",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watchAll",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.unit.ts",
    "test:infra": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.infra.ts",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.e2e.ts",
    "test:unit:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.unit.ts --watch",
    "test:infra:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.infra.ts --watch",
    "test:e2e:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.e2e.ts --watch"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run test:unit && pnpm run prettier-format && pnpm run lint"
    }
  },
  "dependencies": {
    "@talknest/api": "workspace:*",
    "@talknest/errors": "workspace:*",
    "@talknest/core": "workspace:*",
    "@talknest/database": "workspace:*",
    "@talknest/config": "workspace:*",
    "@talknest/bus": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "jwks-rsa": "^4.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@talknest/test-support": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "@types/nodemailer": "^8.0.1",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.11",
    "prisma": "^7.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0"
  }
}
