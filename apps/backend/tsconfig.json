{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["ES2022"],
    "types": ["node", "jest", "jest-cucumber", "@faker-js/faker"],

    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,

    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.infra.ts",
    "**/*.test.ts",
    "**/*.e2e.ts"
  ],
  "references": [
    { "path": "../../packages/api" },
    { "path": "../../packages/errors" },
    { "path": "../../packages/core" }
  ]
}