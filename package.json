{
  "name": "talknest",
  "private": true,
  "version": "1.0.0",
  "description": "A modern forum app where people gather, discuss, and grow.",
  "license": "ISC",
  "author": "Mohamed Kamel",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "clean": "yarn workspaces run clean",
    "clean:deps": "yarn workspaces run clean:deps",
    "lint": "yarn workspaces run lint",
    "start": "yarn workspace @talknest/backend start",
    "build": "yarn build:shared && yarn build:front && yarn build:back",
    "build:shared": "yarn workspace @talknest/shared build",
    "build:front": "yarn workspace @talknest/frontend build",
    "build:back": "yarn workspace @talknest/backend build",
    "start:dev:front": "yarn workspace @talknest/frontend start:dev",
    "start:dev:back": "yarn workspace @talknest/backend start:dev",
    "test:e2e:front": "yarn workspace @talknest/frontend test:e2e",
    "test:unit:back": "yarn workspace @talknest/backend test:unit",
    "test:infra:back": "yarn workspace @talknest/backend test:infra",
    "test:e2e:back": "yarn workspace @talknest/backend test:e2e",
    "start:db": "yarn workspace @talknest/backend start:db",
    "stop:db": "yarn workspace @talknest/backend stop:db",
    "stop:db:volumes": "yarn workspace @talknest/backend stop:db:volumes",
    "db:logs": "yarn workspace @talknest/backend db:logs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.13.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-cucumber": "^4.5.0",
    "onchange": "^7.1.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
