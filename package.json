{
  "name": "talknest",
  "private": true,
  "version": "1.0.0",
  "description": "A modern forum app where people gather, discuss, and grow.",
  "license": "ISC",
  "author": "Mohamed Kamel",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "dev": "turbo run --parallel start:dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean:deps": "pnpm -r --if-present run clean:deps && rimraf node_modules",
    "start": "pnpm --filter @talknest/backend run start",
    "build:api": "pnpm --filter @talknest/api run build",
    "build:errors": "pnpm --filter @talknest/errors run build",
    "build:core": "pnpm --filter @talknest/core run build",
    "build:packages": "pnpm run build:api && pnpm run build:errors && pnpm run build:core",
    "build:front": "pnpm --filter @talknest/frontend run build",
    "build:back": "pnpm --filter @talknest/backend run build",
    "start:dev:front": "pnpm --filter @talknest/frontend run start:dev",
    "start:dev:back": "pnpm --filter @talknest/backend run start:dev",
    "test:e2e:front": "pnpm --filter @talknest/frontend run test:e2e",
    "test:unit:back": "pnpm --filter @talknest/backend run test:unit",
    "test:infra:back": "pnpm --filter @talknest/backend run test:infra",
    "test:e2e:back": "pnpm --filter @talknest/backend run test:e2e",
    "start:db": "docker-compose up -d",
    "stop:db": "docker-compose down",
    "stop:db:volumes": "docker-compose down -v",
    "db:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.13.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-cucumber": "^4.5.0",
    "onchange": "^7.1.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
