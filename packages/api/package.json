{
  "name": "@talknest/api",
  "author": "Mohamed Kamel",
  "private": true,
  "license": "ISC",
  "version": "1.0.0",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "clean:deps": "rimraf node_modules",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./comments": {
      "default": "./src/comments/index.ts",
      "types": "./src/comments/index.ts"
    },
    "./marketing": {
      "default": "./src/marketing/index.ts",
      "types": "./src/marketing/index.ts"
    },
    "./posts": {
      "default": "./src/posts/index.ts",
      "types": "./src/posts/index.ts"
    },
    "./users": {
      "default": "./src/users/index.ts",
      "types": "./src/users/index.ts"
    },
    "./votes": {
      "default": "./src/votes/index.ts",
      "types": "./src/votes/index.ts"
    },
    "./members": {
      "default": "./src/members/index.ts",
      "types": "./src/members/index.ts"
    }
  },
  "dependencies": {
    "@talknest/core": "workspace:*",
    "@talknest/errors": "workspace:*",
    "axios": "^1.6.2",
    "zod": "^4.4.3"
  }
}
