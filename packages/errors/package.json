{
  "name": "@talknest/errors",
  "author": "Mohamed Kamel",
  "private": true,
  "license": "ISC",
  "version": "1.0.0",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "clean:deps": "rimraf node_modules",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./application": {
      "default": "./src/application/index.ts",
      "types": "./src/application/index.ts"
    },
    "./request": {
      "default": "./src/request/index.ts",
      "types": "./src/request/index.ts"
    },
    "./server": {
      "default": "./src/server/index.ts",
      "types": "./src/server/index.ts"
    },
    "./network": {
      "default": "./src/network/index.ts",
      "types": "./src/network/index.ts"
    },
    "./domain": {
      "default": "./src/domain/index.ts",
      "types": "./src/domain/index.ts"
    },
    "./domain/*": {
      "default": "./src/domain/*/index.ts",
      "types": "./src/domain/*/index.ts"
    }
  }
}
