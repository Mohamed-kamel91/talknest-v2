{
  "name": "@talknest/shared",
  "author": "Mohamed Kamel",
  "private": true,
  "license": "ISC",
  "version": "1.0.0",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "clean:deps": "rimraf node_modules",
    "build": "tsc --build"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts",
      "types": "./src/*.ts"
    },
    "./api": {
      "default": "./src/api/index.ts",
      "types": "./src/api/index.ts"
    },
    "./api/*": {
      "default": "./src/api/*.ts",
      "types": "./src/api/*.ts"
    },
    "./errors": {
      "default": "./src/errors/index.ts",
      "types": "./src/errors/index.ts"
    },
    "./errors/*": {
      "default": "./src/errors/*.ts",
      "types": "./src/errors/*.ts"
    }
  }
}
